{
  "name": "cogniroute-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CogniRouteAI – AI инструктор за возење: мобилна апликација (PWA) што ги користи сензорите, камерите и микрофонот на телефонот, и веб-страна со контролна табла.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "dev": "concurrently -k -n api,vite -c blue,magenta \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "dev:phone": "concurrently -k -n api,vite -c blue,magenta \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite --host --mode phone\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:e2e": "node test/e2e/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "onnxruntime-web": "^1.30.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  }
}
