# Copy to .env and fill in. The server reads it on start.

# Claude API key for the AI coach (without it the coach uses built-in rules).
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Port and database file of the server.
# PORT=3000
# DB_FILE=server/data/cogniroute.db
