# Copy to .env and fill in. The server reads it on start.

# Claude API key for the AI coach (without it the coach uses built-in rules).
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Port and database file of the server.
# PORT=3000
# DB_FILE=server/data/cogniroute.db

# Macedonian text-to-speech (Azure AI Speech) for the in-car voice.
# Run `npm run voice` once to record all phrases into public/voice/mk/.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=mk-MK-MarijaNeural   # or mk-MK-AleksandarNeural
